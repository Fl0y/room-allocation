{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:db)",
      "Bash(npm run test:e2e)",
      "Bash(npm run report)",
      "Bash(npm run simulate *)",
      "Bash(npm run data:check *)",
      "Bash(npm run week *)",
      "Bash(npm run interval *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset --hard *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./Claude outputs/personal/**)"
    ]
  }
}
